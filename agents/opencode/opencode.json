{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "agents/AGENTS.md",
    "agents/django.md",
    "agents/frontend.md",
    "agents/architecture-review.md"
  ],
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "frontend/node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      ".uv/**",
      "backend/staticfiles/**",
      "backend/media/**",
      ".astro/**",
      "coverage/**",
      ".coverage",
      ".pytest_cache/**",
      "*.egg-info/**"
    ]
  }
}