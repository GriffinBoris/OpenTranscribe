{
  "name": "open-transcribe",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "icons": "node ../../scripts/generate-icons.mjs",
    "types:generate": "cargo test -p opentranscribe-domain --lib --locked",
    "prepare:sidecar:debug": "node ../../scripts/prepare-sidecar.mjs",
    "prepare:sidecar:release": "node ../../scripts/prepare-sidecar.mjs --release",
    "verify:signing:macos": "node ../../scripts/verify-macos-signing.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"tests/**/*.ts\" \"../../scripts/**/*.mjs\" \"../../docs/**/*.md\" \"../../.github/**/*.{yml,yaml,json}\" \"../../README.md\" \"../../PRIVACY.md\" \"../../SECURITY.md\" \"*.{ts,json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"tests/**/*.ts\" \"../../scripts/**/*.mjs\" \"../../docs/**/*.md\" \"../../.github/**/*.{yml,yaml,json}\" \"../../README.md\" \"../../PRIVACY.md\" \"../../SECURITY.md\" \"*.{ts,json,md,mjs}\"",
    "test": "vitest run",
    "test:ui": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "1.41.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.9",
    "pinia": "4.0.3",
    "primevue": "4.5.5",
    "vue": "3.5.40",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.9"
  },
  "engines": {
    "node": ">=22.12"
  }
}
